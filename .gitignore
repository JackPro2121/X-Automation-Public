# scratch/ holds dev calibration SCRIPTS that CI depends on
# (scratch/check_imports.mjs backs `npm run test:imports`) — keep those.
# The DATA DUMPS are real production content (published post text, source pairs,
# live x.com post URLs) and must never reach the public mirror.
scratch/*.json
scratch/visuals/
